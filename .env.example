# PostgreSQL connection (server-side only — never expose to the browser)
# Local:
# MAIN_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/payloadcms?schema=public
# Neon (use the pooled endpoint; prefer sslmode=require without channel_binding=require):
MAIN_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Payload secret — generate a long random string for production
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: preview secret for draft content
PREVIEW_SECRET=CHANGE_ME_PREVIEW_SECRET

# -----------------------------------------------------------------------------
# Cloudflare R2 media storage (optional — when unset, Media uses local /media)
# All of these are SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
# Cloudflare dashboard → R2 → Overview → Account ID
R2_ACCOUNT_ID=
# R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Exact bucket name
R2_BUCKET_NAME=
# Public base URL with NO trailing slash:
# - Custom domain: https://media.example.com
# - Or R2.dev public URL: https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=
# Optional override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# Optional: set to 1 on Vercel to upload directly from the browser (needs R2 CORS)
# R2_CLIENT_UPLOADS=
